-- ---------- Shared helpers (run once) --------------------------------
CREATE OR REPLACE PROCEDURE public.try_schedule(p_name text, p_cron text, p_cmd text)
LANGUAGE plpgsql AS $$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_extension WHERE extname = 'pg_cron') THEN
        EXECUTE format('SELECT cron.schedule(%L, %L, %L)', p_name, p_cron, p_cmd);
        RAISE NOTICE 'Scheduled job % (%): %', p_name, p_cron, p_cmd;
    ELSE
        RAISE NOTICE 'pg_cron not installed. Would run: cron.schedule(%, %, %)', p_name, p_cron, p_cmd;
    END IF;
END $$;

-- Pins search_path on every routine in a schema so that scheduled jobs
-- and direct SQL from any session still find the right tables.
CREATE OR REPLACE PROCEDURE public.pin_schema(p_schema text)
LANGUAGE plpgsql AS $$
DECLARE r record;
BEGIN
    FOR r IN SELECT p.oid::regprocedure AS sig
             FROM pg_proc p WHERE p.pronamespace = p_schema::regnamespace
    LOOP
        EXECUTE format('ALTER ROUTINE %s SET search_path = %I, public', r.sig, p_schema);
    END LOOP;
END $$;


-- =====================================================================
-- QUESTION 1 : Pharmacy Stock and Daily Sales
-- =====================================================================
DROP SCHEMA IF EXISTS q1 CASCADE;
CREATE SCHEMA q1;
SET search_path TO q1, public;

-- (a) Tables
CREATE TABLE medicines (
    medicine_id   INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    medicine_name VARCHAR(100) NOT NULL,
    unit_price    NUMERIC(10,2) NOT NULL CHECK (unit_price > 0),
    stock_qty     INT NOT NULL CHECK (stock_qty >= 0)
);
CREATE TABLE sales (
    sale_id     INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    medicine_id INT NOT NULL REFERENCES medicines(medicine_id),
    quantity    INT NOT NULL CHECK (quantity > 0),
    unit_price  NUMERIC(10,2) NOT NULL CHECK (unit_price > 0),
    sold_on     DATE NOT NULL
);
CREATE TABLE stock_audit (
    audit_id    INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    medicine_id INT NOT NULL REFERENCES medicines(medicine_id),
    old_qty     INT NOT NULL,
    new_qty     INT NOT NULL,
    changed_at  TIMESTAMP NOT NULL DEFAULT now()
);
CREATE TABLE daily_sales (
    sales_date   DATE PRIMARY KEY,
    total_qty    INT NOT NULL,
    total_amount NUMERIC(12,2) NOT NULL
);

