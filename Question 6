-- (b)
CREATE OR REPLACE FUNCTION fn_net_pay(p_employee_id INT)
RETURNS NUMERIC LANGUAGE plpgsql AS $$
DECLARE v_net NUMERIC;
BEGIN
    SELECT basic_salary + allowance - deduction INTO v_net
    FROM employees WHERE employee_id = p_employee_id;
    IF NOT FOUND THEN
        RAISE EXCEPTION 'Employee % does not exist', p_employee_id;
    END IF;
    IF v_net < 0 THEN
        RAISE EXCEPTION 'Net pay for employee % is negative (%)', p_employee_id, v_net;
    END IF;
    RETURN v_net;
END $$;

-- (c) One transaction: any failed employee aborts the whole call
CREATE OR REPLACE PROCEDURE pr_process_payroll(p_month DATE)
LANGUAGE plpgsql AS $$
DECLARE r RECORD; v_net NUMERIC;
BEGIN
    IF p_month IS NULL OR p_month <> date_trunc('month', p_month)::date THEN
        RAISE EXCEPTION 'Month % must be the first day of a month', p_month;
    END IF;
    FOR r IN SELECT employee_id, basic_salary, allowance
             FROM employees WHERE active ORDER BY employee_id
    LOOP
        v_net := fn_net_pay(r.employee_id);          -- raises on invalid calculation
        INSERT INTO payroll (employee_id, pay_month, gross_pay, net_pay)
        VALUES (r.employee_id, p_month, r.basic_salary + r.allowance, v_net)
        ON CONFLICT (employee_id, pay_month) DO NOTHING;   -- existing rows unchanged
    END LOOP;
END $$;

-- (d)
CREATE OR REPLACE FUNCTION tg_salary_audit() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
    INSERT INTO salary_audit (employee_id, old_salary, new_salary)
    VALUES (NEW.employee_id, OLD.basic_salary, NEW.basic_salary);
    RETURN NULL;
END $$;

CREATE TRIGGER trg_salary_audit
AFTER UPDATE ON employees
FOR EACH ROW
WHEN (OLD.basic_salary IS DISTINCT FROM NEW.basic_salary)
EXECUTE FUNCTION tg_salary_audit();

-- (e) Inner join keeps history for employees who are now inactive
CREATE OR REPLACE VIEW v_payroll_report AS
SELECT e.full_name, p.pay_month, p.gross_pay, p.net_pay
FROM payroll p JOIN employees e ON e.employee_id = p.employee_id;

-- (f) The unique index leads with employee_id, so it cannot serve pay_month-only filters
CREATE INDEX idx_payroll_month ON payroll (pay_month);

CALL public.pin_schema('q6');

-- Seed: two payroll months
CALL pr_process_payroll(DATE '2026-09-01');
UPDATE employees SET basic_salary = 5200 WHERE employee_id = 1;   -- audited
UPDATE employees SET allowance = 350 WHERE employee_id = 2;        -- NOT audited
UPDATE employees SET active = FALSE WHERE employee_id = 4;
CALL pr_process_payroll(DATE '2026-10-01');
CALL pr_process_payroll(DATE '2026-10-01');                         -- rerun: no duplicates

