
-- ---------- Shared helpers (run once) --------------------------------
CREATE OR REPLACE PROCEDURE public.try_schedule(p_name text, p_cron text, p_cmd text)
LANGUAGE plpgsql AS $$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_extension WHERE extname = 'pg_cron') THEN
        EXECUTE format('SELECT cron.schedule(%L, %L, %L)', p_name, p_cron, p_cmd);
        RAISE NOTICE 'Scheduled job % (%): %', p_name, p_cron, p_cmd;
    ELSE
        RAISE NOTICE 'pg_cron not installed. Would run: cron.schedule(%, %, %)', p_name, p_cron, p_cmd;
    END IF;
END $$;

-- Pins search_path on every routine in a schema so that scheduled jobs
-- and direct SQL from any session still find the right tables.
CREATE OR REPLACE PROCEDURE public.pin_schema(p_schema text)
LANGUAGE plpgsql AS $$
DECLARE r record;
BEGIN
    FOR r IN SELECT p.oid::regprocedure AS sig
             FROM pg_proc p WHERE p.pronamespace = p_schema::regnamespace
    LOOP
        EXECUTE format('ALTER ROUTINE %s SET search_path = %I, public', r.sig, p_schema);
    END LOOP;
END $$;


